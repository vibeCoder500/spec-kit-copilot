{
    "name": "speckit-sdd-repository-browser-build",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Build-only repository discovery and connection assets for the SDD canvas.",
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "node --import tsx --test \"test/*.test.ts\"",
        "build:proof": "node build.mjs",
        "verify:proof": "node build.mjs --verify",
        "build": "node build-runtime.mjs",
        "verify:package": "node build-runtime.mjs --verify",
        "dev": "node ../../../../../scripts/canvas-reader/serve-repositories.mjs"
    },
    "devDependencies": {
        "@azure/msal-node": "6.0.0",
        "@eslint/js": "10.0.1",
        "@types/node": "24.10.0",
        "esbuild": "0.28.2",
        "eslint": "10.9.1",
        "lucide": "1.42.0",
        "open": "11.0.2",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "typescript-eslint": "8.68.0",
        "yaml": "2.9.0"
    }
}
